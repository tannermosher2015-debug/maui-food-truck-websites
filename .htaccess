# Repo-management files have no reason to be public. The git deploy publishes
# whatever is tracked, so README.md and .gitignore were both served 200 at the
# domain root, exposing the repo path and the deploy mechanism. Measured
# 2026-08-27. .env, .git/* and .htaccess were already correctly 403.
<FilesMatch "^(README\.md|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Four URLs served the identical homepage with no consolidation, leaving the
# canonical tag (a hint Google may override) doing all the work on its own.
# A 301 is the stronger signal and the two stack. Measured 2026-08-27.
<IfModule mod_rewrite.c>
RewriteEngine On
# www to the bare apex, preserving the path and query
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,QSA]
# /index.html to /
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
# /any/dir/index.html to /any/dir/ . The rule above is ROOT ONLY: its \s/+ demands
# the slash sit right after the request whitespace, so it never matches a nested
# path. Without this the area pages added 2026-08-27 each answer 200 on TWO urls.
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]
</IfModule>

<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
# The server was labelling .js as application/x-javascript, which matched neither
# the DEFLATE list nor the ExpiresByType rule below, so site.js was served with a
# 7 day max-age while site.css got 30. Measured live 2026-08-27.
<IfModule mod_mime.c>
AddType application/javascript .js
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType application/x-javascript "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
# Do not let a browser sniff a response into a different type than we declared.
Header always set X-Content-Type-Options "nosniff"
# No third party may frame this site.
Header always set X-Frame-Options "SAMEORIGIN"
# Send the full referrer to ourselves, only the origin to other sites.
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
