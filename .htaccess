<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
# Do not let a browser sniff a response into a different type than we declared.
Header always set X-Content-Type-Options "nosniff"
# No third party may frame this site.
Header always set X-Frame-Options "SAMEORIGIN"
# Send the full referrer to ourselves, only the origin to other sites.
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# HTTPS only for one year. NOTE: this is sticky in the browser and cannot be
# un-done for a visitor who has already seen it, so the cert must never lapse.
# Deliberately no includeSubDomains and no preload.
Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
