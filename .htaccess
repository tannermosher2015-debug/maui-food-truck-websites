<FilesMatch "\.html$">
Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
# The server was labelling .js as application/x-javascript, which matched neither
# the DEFLATE list nor the ExpiresByType rule below, so site.js was served with a
# 7 day max-age while site.css got 30. Measured live 2026-08-27.
<IfModule mod_mime.c>
AddType application/javascript .js
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType application/x-javascript "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
# Do not let a browser sniff a response into a different type than we declared.
Header always set X-Content-Type-Options "nosniff"
# No third party may frame this site.
Header always set X-Frame-Options "SAMEORIGIN"
# Send the full referrer to ourselves, only the origin to other sites.
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
